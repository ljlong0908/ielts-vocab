/* M8：底栏高 16 + 88 + 8 + 88 + 24 = 224rpx → 内容区留 240rpx，避免累计数字被遮 */
.page {
  padding-bottom: 240rpx;
}

.ck {
  text-align: center;
  padding: 96rpx 24rpx 64rpx;
}

.ck-check {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--success-soft);
  margin: 0 auto 40rpx;
  position: relative;
}

/* 对勾是图形（非文字），用 --success */
.ck-check::after {
  content: '';
  position: absolute;
  left: 46rpx;
  top: 34rpx;
  width: 34rpx;
  height: 62rpx;
  border-right: 10rpx solid var(--success);
  border-bottom: 10rpx solid var(--success);
  transform: rotate(45deg);
}

.ck-title {
  font-size: 44rpx;
  font-weight: 500;
}

.ck-sub {
  margin-top: 12rpx;
}

.ck-streak {
  margin-top: 64rpx;
}

.ck-streak-num {
  font-size: 120rpx;
  font-weight: 500;
  color: var(--primary);
  line-height: 1.1;
}

.ck-streak-label {
  color: var(--text-2);
  font-size: 26rpx;
}

.ck-total {
  margin-top: 16rpx;
}

/* 底栏内主按钮与分享之间的间距（原来靠 .btn.primary 的 margin-top，已随底栏改造移除） */
.bottombar .btn.primary {
  margin-bottom: 8rpx;
}

/* M8 分享按钮降权：button 组件自带默认样式，这里重置成"文字链接"外观。
   保留 height:88rpx（热区下限 44px），只压掉填充/描边/字重 */
.share-btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  background: transparent;
  border: none;
  color: var(--primary);
  font-size: 28rpx;
  font-weight: normal;
}

.share-btn::after {
  border: none;
}
