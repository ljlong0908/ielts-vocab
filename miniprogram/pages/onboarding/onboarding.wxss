.ob {
  padding-top: 96rpx;
}

.ob-head {
  margin-bottom: 64rpx;
}

.ob-title {
  font-size: 44rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.ob-option {
  display: flex;
  align-items: baseline;
  background: #ffffff;
  border: 2rpx solid #e5e6eb;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.ob-option.active {
  border-color: #185fa5;
  background: #e6f1fb;
}

.ob-option-num {
  font-size: 52rpx;
  font-weight: 500;
  color: #185fa5;
  margin-right: 16rpx;
}

.ob-option-text {
  font-size: 28rpx;
  color: #646a73;
}

.ob-btn {
  margin-top: 48rpx;
}
