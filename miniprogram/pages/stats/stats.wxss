.metrics {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.metric {
  flex: 1;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
}

.metric-num {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--primary);
}

.metric-label {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}

.cal-head {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
  text-align: center;
}

.cal-week {
  display: flex;
}

.cal-week-cell {
  width: 14.28%;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-2);
  padding-bottom: 12rpx;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

/* 日历热区挂外层 88rpx，视觉圆 .cal-day 仍是 60rpx（M2 通用解法） */
.cal-cell {
  width: 14.28%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-day {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  color: var(--text);
}

.cal-day.checked {
  background: var(--success-deep);
  color: #ffffff;
}

.cal-day.today {
  border: 2rpx solid var(--primary);
}

.cal-day.checked.today {
  color: #ffffff;
}

.cal-tip {
  margin-top: 16rpx;
  text-align: center;
}
