<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中</view>

  <view wx:elif="{{words.length === 0}}" class="empty">还没有错题，继续保持</view>

  <block wx:else>
    <view wx:for="{{words}}" wx:key="_id" class="card wb-item">
      <view class="between">
        <view class="wb-main">
          <view class="wb-word">{{item.word}}</view>
          <view class="wb-phonetic">{{item.phoneticUS || item.phoneticUK}}</view>
          <view class="wb-meaning">{{item.meaning}}</view>
        </view>
        <view class="speaker" data-word="{{item.word}}" bindtap="play">
          <view class="speaker-icon"></view>
        </view>
      </view>
    </view>
  </block>
</view>
