.head {
  margin-bottom: 24rpx;
}

.q-type {
  font-size: 24rpx;
  color: #8f959e;
  margin-bottom: 16rpx;
}

.q-stem-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.q-stem {
  font-size: 46rpx;
  font-weight: 500;
  line-height: 1.4;
}

.speaker {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #e6f1fb;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.speaker-icon {
  width: 0;
  height: 0;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  border-left: 20rpx solid #185fa5;
  margin-left: 5rpx;
}

.phonetic {
  color: #646a73;
  font-size: 26rpx;
  margin-top: 10rpx;
}

.options {
  margin-top: 8rpx;
}

.option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #ffffff;
  border: 2rpx solid #e5e6eb;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.option.ok {
  border-color: #1d9e75;
  background: #e1f5ee;
}

.option.bad {
  border-color: #a32d2d;
  background: #fcebeb;
}

.option.answer {
  border-color: #1d9e75;
  background: #e1f5ee;
}

.opt-key {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f1f2f4;
  color: #646a73;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option.ok .opt-key,
.option.answer .opt-key {
  background: #1d9e75;
  color: #ffffff;
}

.option.bad .opt-key {
  background: #a32d2d;
  color: #ffffff;
}

.opt-text {
  font-size: 30rpx;
  color: #1f2329;
}

.feedback {
  text-align: center;
  font-size: 26rpx;
  margin-top: 12rpx;
}

.ok-text {
  color: #1d9e75;
}

.bad-text {
  color: #a32d2d;
}
