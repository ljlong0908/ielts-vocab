.head {
  margin-bottom: 24rpx;
}

.q-type {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
}

.q-stem-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.q-stem {
  font-size: 46rpx;
  font-weight: 500;
  line-height: 1.4;
}

/* .speaker / .speaker-icon 的热区与喇叭图形由 app.wxss 提供，此处只覆盖视觉圆尺寸 */
.speaker-icon {
  width: 60rpx;
  height: 60rpx;
}

.phonetic {
  color: var(--text-2);
  font-size: 26rpx;
  margin-top: 10rpx;
}

.options {
  margin-top: 8rpx;
}

.option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.option.ok {
  border-color: var(--success);
  background: var(--success-soft);
}

.option.bad {
  border-color: var(--danger);
  background: var(--danger-soft);
}

.option.answer {
  border-color: var(--success);
  background: var(--success-soft);
}

.opt-key {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f1f2f4;
  color: var(--text-2);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option.ok .opt-key,
.option.answer .opt-key {
  background: var(--success-deep);
  color: #ffffff;
}

.option.bad .opt-key {
  background: var(--danger);
  color: #ffffff;
}

.opt-text {
  font-size: 30rpx;
  color: var(--text);
}

.feedback {
  text-align: center;
  font-size: 26rpx;
  margin-top: 12rpx;
}

.ok-text {
  color: var(--success-deep);
}

.bad-text {
  color: var(--danger);
}
