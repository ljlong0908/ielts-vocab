<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中</view>
  <view wx:elif="{{empty}}" class="empty">词库已学完，明天再来吧</view>

  <block wx:else>
    <view class="between head">
      <view class="hint">{{isReview ? '错题复习' : (isExtra ? '加练单词' : '今日新词')}}</view>
      <view class="tag">{{index + 1}} / {{total}}</view>
    </view>

    <view wx:if="{{cardLoading}}" class="loading">正在生成学习内容</view>

    <block wx:elif="{{card}}">
      <view class="card">
        <view class="word-row">
          <text class="word">{{card.word}}</text>
          <view class="speaker" hover-class="hover-dim" bindtap="play">
            <view class="speaker-icon"></view>
          </view>
        </view>
        <view class="phonetic">{{card.phoneticUS || card.phoneticUK}}</view>
        <view wx:if="{{card.pos}}" class="pos">{{card.pos}}</view>
        <view class="meaning">{{card.meaning}}</view>
        <view wx:if="{{card.enriching}}" class="hint enriching-tip">扩展内容生成中，稍后自动补全</view>
      </view>

      <view class="card">
        <view class="sec-title sec-head">
          <text>例句</text>
          <!-- 例句发音：整句音频由本地 Kokoro 预生成，未预置时静默不播 -->
          <view wx:if="{{card.example}}" class="speaker speaker-sm" hover-class="hover-dim" bindtap="playExample">
            <view class="speaker-icon"></view>
          </view>
        </view>
        <block wx:if="{{card.example}}">
          <view class="example-en">{{card.example.en}}</view>
          <view class="example-cn">{{card.example.cn}}</view>
        </block>
        <view wx:else class="hint">暂缺</view>
      </view>

      <view class="card">
        <view class="sec-title">词根拆解</view>
        <block wx:if="{{card.roots.length}}">
          <view wx:for="{{card.roots}}" wx:key="part" class="root-item">
            <text class="root-part">{{item.part}}</text>
            <text class="root-type">{{item.type}}</text>
            <text class="root-meaning">{{item.meaning}}</text>
          </view>
        </block>
        <view wx:else class="hint">暂缺</view>
      </view>

      <view class="card">
        <view class="sec-title">单词演变</view>
        <view wx:if="{{card.etymology}}" class="etymology">{{card.etymology}}</view>
        <view wx:else class="hint">暂缺</view>
      </view>
    </block>
  </block>

  <!-- M6：主操作移出文档流固定底部 —— 本页是全站最高频操作页（每词点一次），
       「主按钮进拇指区」在这里收益最大。分段进度固定在底栏上方：
       词的进度是离散的，且顶部那个「1 / 6」tag 一滑就滚没了 -->
  <view wx:if="{{!loading && !empty}}" class="bottombar">
    <view class="seg-progress">
      <view wx:for="{{segs}}" wx:key="k" class="seg {{item.cls}}"></view>
    </view>
    <view
      class="btn primary {{locked ? 'disabled' : ''}}"
      hover-class="hover-press"
      bindtap="next"
    >{{nextLabel}}</view>
  </view>
</view>
