<view class="page">
  <view wx:if="{{empty}}" class="empty">词库已学完，明天再来吧</view>

  <block wx:else>
    <view class="between head">
      <view class="hint">{{isReview ? '错题复习' : (isExtra ? '加练单词' : '今日新词')}}</view>
      <view class="tag">{{index + 1}} / {{total}}</view>
    </view>

    <view wx:if="{{cardLoading}}" class="loading">正在生成学习内容</view>

    <block wx:elif="{{card}}">
      <view class="card">
        <view class="word-row">
          <text class="word">{{card.word}}</text>
          <view class="speaker" hover-class="hover-dim" bindtap="play">
            <view class="speaker-icon"></view>
          </view>
        </view>
        <view class="phonetic">{{card.phoneticUS || card.phoneticUK}}</view>
        <view wx:if="{{card.pos}}" class="pos">{{card.pos}}</view>
        <view class="meaning">{{card.meaning}}</view>
        <view wx:if="{{card.enriching}}" class="hint enriching-tip">扩展内容生成中，稍后自动补全</view>
      </view>

      <view class="card">
        <view class="sec-title">词根拆解</view>
        <block wx:if="{{card.roots.length}}">
          <view wx:for="{{card.roots}}" wx:key="part" class="root-item">
            <text class="root-part">{{item.part}}</text>
            <text class="root-type">{{item.type}}</text>
            <text class="root-meaning">{{item.meaning}}</text>
          </view>
        </block>
        <view wx:else class="hint">暂缺</view>
      </view>

      <!-- 形似词（D12）：库里字形相近、易记混的词，最多 3 条，按相似度降序。
           数据离线预计算写在 words.similar（gen_similar.py → seed_similar.py），
           随 word_card 透传，云函数零改动。
           · 每行 = 单词 + 音标 + 小喇叭（点喇叭发音，复用 playWord）+ 释义；
           · card.similar 用 && 兜底：老数据 / 将来 seed_words 导入的新词没有该字段，
             不能因为取个长度就把页面炸掉；
           · 空态与例句/词根等区块一致显示「暂缺」（约 8.5% 的词在库内无形似词）。
           折叠（D13）：默认收起省高度（学习页五个卡片纵向堆叠，展开态约占屏 1/4），
           收起时标题行右侧显示「N 个」提示有货；点标题行切换，翻词不重置。
             喇叭在内容区不在标题区，与 toggleSimilar 的热区不重叠。 -->
      <view class="card">
        <view class="sec-title sec-head" hover-class="hover-dim" bindtap="toggleSimilar">
          <view class="sec-title-main">
            <text>形似词</text>
            <text wx:if="{{card.similar && card.similar.length && !similarOpen}}" class="sec-count">{{card.similar.length}} 个</text>
          </view>
          <view class="sec-toggle">
            <text wx:if="{{card.similar && card.similar.length && similarOpen}}" class="sec-sub">字形相近，别记混</text>
            <view wx:if="{{card.similar && card.similar.length}}" class="sec-arrow {{similarOpen ? 'up' : ''}}"></view>
          </view>
        </view>
        <block wx:if="{{card.similar && card.similar.length && similarOpen}}">
          <view wx:for="{{card.similar}}" wx:key="word" class="similar-item">
            <view class="similar-head">
              <text class="similar-word">{{item.word}}</text>
              <text class="similar-phonetic">{{item.phonetic}}</text>
              <view class="speaker speaker-sm" hover-class="hover-dim" bindtap="playSimilar" data-word="{{item.word}}">
                <view class="speaker-icon"></view>
              </view>
            </view>
            <view class="similar-meaning">{{item.meaning}}</view>
          </view>
        </block>
        <view wx:elif="{{!card.similar || !card.similar.length}}" class="hint">暂缺</view>
      </view>

      <view class="card">
        <view class="sec-title sec-head">
          <text>例句</text>
          <!-- 例句发音：整句音频由本地 Kokoro 预生成，未预置时静默不播 -->
          <view wx:if="{{card.example}}" class="speaker speaker-sm" hover-class="hover-dim" bindtap="playExample">
            <view class="speaker-icon"></view>
          </view>
        </view>
        <block wx:if="{{card.example}}">
          <view class="example-en">{{card.example.en}}</view>
          <view class="example-cn">{{card.example.cn}}</view>
        </block>
        <view wx:else class="hint">暂缺</view>
      </view>

      <view class="card">
        <view class="sec-title">单词演变</view>
        <view wx:if="{{card.etymology}}" class="etymology">{{card.etymology}}</view>
        <view wx:else class="hint">暂缺</view>
      </view>
    </block>
  </block>

  <!-- M6：主操作移出文档流固定底部 —— 本页是全站最高频操作页（每词点一次），
       「主按钮进拇指区」在这里收益最大。分段进度固定在底栏上方：
       词的进度是离散的，且顶部那个「1 / 6」tag 一滑就滚没了 -->
  <view wx:if="{{!loading && !empty}}" class="bottombar">
    <view class="seg-progress">
      <view wx:for="{{segs}}" wx:key="k" class="seg {{item.cls}}"></view>
    </view>
    <!-- 「上一个」只在 index>0 时渲染：第 1 个词没有上一个（边界兜底另在 prev() 里），
         错题复习单卡同样不显示。主按钮保持满宽，不被次级按钮挤窄 -->
    <view class="btn-row">
      <view
        wx:if="{{index > 0}}"
        class="btn ghost {{locked ? 'disabled' : ''}}"
        hover-class="hover-press"
        bindtap="prev"
      >上一个</view>
      <view
        class="btn primary {{locked ? 'disabled' : ''}}"
        hover-class="hover-press"
        bindtap="next"
      >{{nextLabel}}</view>
    </view>
  </view>
</view>
