/* M6 固定底栏：16 + 24(分段) + 88(按钮) + 24 = 152rpx，留 200rpx 富余，
   避免最后一张卡（单词演变）被永久遮住 */
.page {
  padding-bottom: 200rpx;
}

/* 分段进度：N 个词 = N 段。done 实心、cur 半透明、未到为灰线 */
.seg-progress {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.seg {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
}

.seg.done {
  background: var(--primary);
}

.seg.cur {
  background: var(--primary);
  opacity: 0.45;
}

.head {
  margin-bottom: 24rpx;
}

.word-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.word {
  font-size: 60rpx;
  font-weight: 500;
  line-height: 1.3;
}

/* .speaker / .speaker-icon 的热区（88rpx）与喇叭图形由 app.wxss 统一提供；
   此处只覆盖视觉圆尺寸。原 CSS 三角形已废弃（移动端为「播放视频」语义）。 */
.speaker-icon {
  width: 64rpx;
  height: 64rpx;
}

.phonetic {
  color: var(--text-2);
  font-size: 28rpx;
  margin-top: 8rpx;
}

.pos {
  display: inline-block;
  margin-top: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  background: #f1efe8;
  color: #5f5e5a;
  font-size: 22rpx;
}

.meaning {
  font-size: 34rpx;
  font-weight: 500;
  margin-top: 16rpx;
}

.enriching-tip {
  margin-top: 16rpx;
}

.sec-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--primary);
  margin-bottom: 16rpx;
}

.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 例句喇叭：视觉圆更小，热区仍是 88rpx */
.speaker-sm .speaker-icon {
  width: 48rpx;
  height: 48rpx;
}

.example-en {
  font-size: 30rpx;
  line-height: 1.7;
}

.example-cn {
  color: var(--text-2);
  font-size: 26rpx;
  margin-top: 8rpx;
}

.root-item {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f1f2f4;
}

.root-item:last-child {
  border-bottom: none;
}

.root-part {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--success-deep);
}

.root-type {
  font-size: 24rpx;
  color: var(--text-2);
  background: #f5f6f7;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.root-meaning {
  font-size: 28rpx;
  color: var(--text);
}

.etymology {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text);
}
