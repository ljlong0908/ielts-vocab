/* 全局样式与设计变量 */
page {
  --primary: #185fa5;
  --primary-soft: #e6f1fb;
  --success: #1d9e75;
  --success-soft: #e1f5ee;
  --warn: #ba7517;
  --danger: #a32d2d;
  --danger-soft: #fcebeb;
  --bg: #f6f7f9;
  --surface: #ffffff;
  --text: #1f2329;
  --text-2: #646a73;
  --text-3: #8f959e;
  --line: #e5e6eb;
  --radius: 20rpx;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--line);
}

.title {
  font-size: 34rpx;
  font-weight: 500;
}

.muted {
  color: var(--text-2);
  font-size: 26rpx;
}

.hint {
  color: var(--text-3);
  font-size: 24rpx;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 30rpx;
  background: var(--surface);
  color: var(--text);
  border: 1rpx solid var(--line);
}

.btn.primary {
  background: var(--primary);
  color: #fff;
  border: none;
}

.btn.disabled {
  opacity: 0.45;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--primary-soft);
  color: var(--primary);
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--text-3);
}
