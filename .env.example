# 雅词本 —— 本地环境变量示例
#
# 用法：复制成 .env 再按注释填写。.env 已被 .gitignore 忽略，绝不要提交。
#
#     cp .env.example .env
#
# 这里放的都是「本机工具链」的凭证：scripts/*.py 会读取项目根目录的 .env。
# 云函数运行时的环境变量**不在这里配**，要在云开发控制台逐个函数配置（见 docs/deploy.md §3）。

# ── 云开发三件套 ──────────────────────────────────────────────
# 小程序 AppID：微信公众平台 → 开发管理 → 开发设置
# 留空也能跑：scripts 会回退去读 project.config.json（二者均非密钥）
WX_APPID=

# 云开发环境 ID：开发者工具 → 云开发 → 环境设置
# 留空也能跑：scripts 会回退去读 miniprogram/config.js 的 ENV_ID
ENV_ID=

# AppSecret：⚠️ 小程序最高权限凭证
# 只放本地 .env，绝不要写进代码、云函数环境变量或提交进仓库
WX_APP_SECRET=

# ── 云函数所需的密钥（本地也留一份，方便走控制台路径 / 离线生成）──
# 管理类函数的鉴权口令，建议 openssl rand -hex 24 生成
# 需在 init_db / seed_words / seed_audio / reset_words / enrich_word 上分别配置同一个值
ADMIN_TOKEN=

# DeepSeek API Key：配给 enrich_word 云函数；同时被 gen_examples.py 用于离线生成例句
# 前端包体里不得出现任何 sk- 字面量
DEEPSEEK_API_KEY=

# ── 可选覆盖（一般不用填，留空即用脚本内置默认值）──────────────
# DEEPSEEK_ENDPOINT=
# DEEPSEEK_MODEL=
# DEEPSEEK_TIMEOUT_MS=
